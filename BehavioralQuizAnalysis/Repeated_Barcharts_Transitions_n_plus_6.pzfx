<HugeTable ID="Table3" XFormat="none" YFormat="replicates" Replicates="67" TableType="TwoWay" EVFormat="AsteriskAfterNumber">
<Title>Grouped: Multiple t tests</Title>
<FloatingNote ID="Sticky3" Auto="0" Color="Yellow" Left="1426" Top="370" Width="178" Height="236" ScrWidth="1920" ScrHeight="1080" ScrDPI="96">
<WebLink Flags="0" ToolTip="@help:stat_options_for_multiple_t_tests.htm" URL="@help:stat_options_for_multiple_t_tests.htm">
Learn about the multiple t test analysis
</WebLink>

<Font Size="10" Color="#000000" Face="Arial">Each row represents a different experiment or issue. The two columns represent control vs. treated conditions in triplicate. </Font>
<Font Size="10" Color="#000000" Face="Arial"><BR/><BR/>Click Analyze, then pick Multiple t tests from the list of analyses of  Grouped data. </Font>
</FloatingNote>

